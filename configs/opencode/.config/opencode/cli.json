{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "app.exit": "ctrl+q",
    "theme.switch": "none",
    "opencode.status": "none",
    "session.list": "<leader>s",
    "session.child.first": "alt+d",
    "session.parent": "alt+u",
    "variant.cycle": "none",
    "variant.list": "<leader>t",
    "session.page.up": "pageup,alt+b",
    "session.page.down": "pagedown,alt+f",
    "session.first": "home,alt+g",
    "session.last": "end,alt+shift+g",
    "input.newline": "shift+return",
    "input.delete.to.line.end": "none",
    "prompt.history.previous": "alt+p",
    "prompt.history.next": "alt+n"
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true
}
