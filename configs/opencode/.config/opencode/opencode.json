{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "openai/gpt-6.1-sol",
  "instructions": [
    "~/AGENTS.md"
  ],
  "default_agent": "orchestrator",
  "agents": {
    "title": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6-luna",
        "variant": "low"
      }
    },
    "plan": {
      "model": {
        "providerID": "openai",
        "model": "openai/gpt-6-astra",
        "variant": "high"
      }
    },
    "build": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.1-sol",
        "variant": "medium"
      }
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "opencode-wakatime",
    "oh-my-opencode-slim",
    "@rama_nigg/open-cursor"
  ],
  "websearch": {
    "provider": "parallel"
  },
  "mcp": {
    "servers": {
      "superlogical": {
        "type": "remote",
        "url": "https://www.superlogical.com/rex/community-mcp"
      }
    }
  }
}
