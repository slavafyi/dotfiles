{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "openai/gpt-6.1-sol",
  "instructions": ["~/AGENTS.md"],
  "default_agent": "orchestrator",
  "agent": {
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "plan": {
      "model": "openai/gpt-6-astra",
      "variant": "high"
    },
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugin": ["opencode-wakatime", "oh-my-opencode-slim"],
  "websearch": {
    "provider": "parallel"
  }
}
